// 1. Define uma lista de IPs confiáveis (Whitelist - ex: IPs corporativos, VPNs aprovadas)
let IpsValidos = dynamic([
    "192.168.10.0/29",
    "10.20.30.0/29"
]);

// 2. Obtém o status mais recente das identidades (Habilitada/Desabilitada)
let ContasInfo = IdentityInfo
| summarize arg_max(Timestamp, IsAccountEnabled) by AccountObjectId
| project AccountObjectId, IsAccountEnabled;

EntraIdSignInEvents
// 3. Define a janela de tempo da busca (ex: últimos 30 dias)
| where Timestamp > ago(30d)
// 4. Filtra apenas por códigos de erro relacionados a bloqueios de segurança:
// 50074, 50076, 50079: Erros variados de exigência ou falha de MFA
// 53003, 50072: Acesso Condicional (Conditional Access) bloqueando a requisição
| where ErrorCode in (50074, 50076, 50072, 50079, 53003)
// 5. Verifica se o IP do evento está dentro da lista de IPs válidos declarada acima
| extend IpConhecido = coalesce(ipv4_is_in_any_range(IPAddress, IpsValidos), false)
// Remove os eventos cujos IPs são conhecidos (Whitelist)
| where not(IpConhecido)
// 6. Determina a geo-localização do IP de origem (Focado no Brasil como baseline)
| extend GeoStatus = case(
    isempty(Country), "SemGeo",   // Se não houver informação de país
    Country == "BR",  "BR",       // Se for tráfego originado do Brasil
                      "Exterior"  // Qualquer outro país
)
// 7. Exclui o tráfego do país de baseline, mantendo apenas ataques externos ou de IPs anônimos
| where GeoStatus != "BR"
// 8. Cruza as informações com o status da conta para validar se o alvo é relevante
| lookup kind=leftouter ContasInfo on AccountObjectId
// 9. Agrupa os eventos pela origem do ataque (IP) e localidade para criar o alerta consolidado
| summarize
    ContasAlvo        = dcount(AccountObjectId), // Total de contas únicas que este IP tentou acessar
    ContasHabilitadas = dcountif(AccountObjectId, IsAccountEnabled == true), // Dessas contas, quantas estão ativas?
    TotalFalhas       = count(), // Volume total de tentativas do atacante
    Paises            = make_set(Country, 20), // Lista de países vinculados ao IP (útil se o IP rodar por proxy)
    Cidades           = make_set(strcat(Country, "/", City), 20), // Cidades do atacante
    Primeira          = min(Timestamp), // Início do ataque
    Ultima            = max(Timestamp), // Último registro do ataque
    Contas            = make_set_if(AccountUpn, IsAccountEnabled == true, 50) // Lista dos e-mails (UPNs) alvos que estão ativos
    by IPAddress, GeoStatus
// 10. Redução de falsos positivos: o alerta só dispara se o alvo possuir pelo menos 1 conta HABILITADA
| where ContasHabilitadas >= 1
// 11. Ordena os IPs mais críticos (que tentaram acessar mais contas habilitadas) primeiro
| order by ContasHabilitadas desc
```
